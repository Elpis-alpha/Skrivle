# Copy to .env and fill in. `.env` is gitignored.

# HTTP port the Node process listens on. Nginx (prod) / the front-end (dev) sit
# in front of it.
PORT=4000

# development | production
NODE_ENV=development

# PostgreSQL connection string. Postgres is NOT bundled with this service:
#   dev  — a local Postgres install
#   prod — an external managed Postgres
# From inside the Docker container a local dev DB is at host.docker.internal.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skrivle?schema=public

# Browser origin allowed to call /api and open sockets (the front-end).
CORS_ORIGIN=http://localhost:3000

# Secret for signing session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# OAuth apps (Phase 1). Leave blank until sign-in is wired up.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
