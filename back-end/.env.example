# Copy to .env and fill in. `.env` is gitignored.

# HTTP port the Node process listens on. Nginx (prod) / the front-end (dev) sit
# in front of it.
PORT=4000

# development | production
NODE_ENV=development

# PostgreSQL connection string. Postgres is NOT bundled with this service:
#   dev  — a local Postgres install
#   prod — an external managed Postgres
# From inside the Docker container a local dev DB is at host.docker.internal.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skrivle?schema=public

# Redis connection string. Redis IS bundled with this service (docker-compose.yml),
# unlike Postgres. For a host-run process use localhost; the container overrides
# this to redis://redis:6379.
#
# Redis holds every short-lived thing: sessions, sign-in codes, OAuth state, and
# rate-limit counters. None of it is in Postgres — see prisma/schema.prisma.
REDIS_URL=redis://localhost:6379

# Browser origin(s) allowed to call /api and open sockets. Comma-separated for
# more than one (e.g. a preview deployment alongside production).
CORS_ORIGIN=http://localhost:3000

# Where OAuth sends the browser back to once a session exists.
FRONTEND_URL=http://localhost:3000

# This server's own public base URL. Used to build the OAuth redirect_uri, so it
# must match what is registered with GitHub and Google exactly.
API_PUBLIC_URL=http://localhost:4000

# HMAC pepper for session ids, sign-in codes, and creator tokens — so a database
# or Redis dump on its own yields nothing usable. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Mail: one-time sign-in codes, sent with nodemailer over Gmail OAuth2 ---
#
# MAIL_REDIRECT_URI is NOT a Skrivle route. It is the redirect the refresh token
# was originally minted against (typically the Google OAuth Playground), and
# nodemailer replays it on every token refresh. Leave it pointing there.
#
# Caveat worth knowing: while the mail project's OAuth consent screen is in
# "Testing" publishing status, MAIL_REFRESH_TOKEN expires after 7 days. Move the
# project to "In production" or sign-in email stops working weekly.
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
MAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
MAIL_REFRESH_TOKEN=
MAIL_ADDRESS=

# --- OAuth sign-in apps ---
#
# Register this redirect URI with each provider:
#   ${API_PUBLIC_URL}/api/auth/callback/github
#   ${API_PUBLIC_URL}/api/auth/callback/google
#
# Google accepts several redirect URIs on one client, so dev and prod can share
# an app. GitHub OAuth Apps accept exactly one, so dev needs its own app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary: board thumbnails and uploaded avatars ---
# The API secret never leaves the server; the browser uploads directly to
# Cloudinary using a signature minted by POST /api/uploads/signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skrivle
