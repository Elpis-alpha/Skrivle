# Where the back-end lives.
#
# Optional: src/lib/api/config.ts falls back to http://localhost:4000 in
# development and https://api.skrivle.elpis.cc otherwise, so a fresh clone runs
# with no .env at all.
#
# NEXT_PUBLIC_* is inlined by `next build`, not read at runtime — to point a
# build at another API it must be set for the build command itself. A
# wrangler.jsonc `var` or a .dev.vars entry has no effect on it.
NEXT_PUBLIC_API_URL=http://localhost:4000
